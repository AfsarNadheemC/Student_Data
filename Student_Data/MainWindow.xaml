<Window x:Class="Student_Data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Student_Data"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="400" d:DataContext="{d:DesignInstance Type=local:ViewModel }" Topmost="True">
    <Grid Margin="5,0">

        <Grid.RowDefinitions>
            
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SchoolName}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0"/>
        <TextBlock Text="{Binding Class}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0"/>
        <TextBlock Text="{Binding TeacherName}"  FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1"/>

        <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="80" Height="5" Fill="LightGray" RadiusX="2.5" RadiusY="2.5" Margin="0,0"/>
        <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="40" Height="5" Fill="ForestGreen" RadiusX="2.5" RadiusY="2.5" Margin="0,0"/>


        
        <ItemsControl ItemsSource="{Binding Students}" Grid.Row="2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Background="WhiteSmoke" Margin="5" CornerRadius="15" Height="40" MouseDown="StudentData_MouseDown" >

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="0" Opacity="0.3" />
                        </Border.Effect>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>                            
                            
                            <Ellipse Grid.Column="0" Fill="{Binding LabelColorDim}" Margin="2" />
                            <TextBlock Text="{Binding Initial}"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{Binding LabelColorDark}"/>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="5,0" Grid.Row="0" Padding="0" VerticalAlignment="Center"/>

                                <Rectangle Width="100" Height="5" Fill="LightGray" RadiusX="2.5" RadiusY="2.5" Grid.Row="1" HorizontalAlignment="Left" Margin="5,0" />
                                <Rectangle Width="{Binding Percentage}" Height="5" Fill="{Binding ProgressColor}" RadiusX="2.5" RadiusY="2.5" Grid.Row="1" HorizontalAlignment="Left" />

                            </Grid>

                            <Image Grid.Column="2" Source="H:\Software\C#\UI\Student_Data\Student_Data\assets\trophy.png" Height="30" HorizontalAlignment="Right"/>

                            <TextBlock Text="{Binding Rank}" Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>

                            <Image Grid.Column="4" Source="H:\Software\C#\UI\Student_Data\Student_Data\assets\chevron.png" Height="30" HorizontalAlignment="Right" Opacity="0.5"/>
                        </Grid>
                                                
                    </Border>
                    
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        
        <Border x:Name="SingleStudentDetailBorder" Visibility="Visible" Grid.Row="2" CornerRadius="20" Margin="10" Background="WhiteSmoke" DataContext="{Binding Path=SelectedStudent}" >
            <Border.Effect>                
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="0" Opacity="0.3" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>                    
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/> 
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Top" FontSize="16" FontWeight="SemiBold" Margin="10,5,0,0" Grid.Column="0" />

                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="100" Height="5" Fill="LightGray" RadiusX="2.5" RadiusY="2.5" Margin="10,0,0,10" Grid.Column="0" />
                    <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="{Binding Percentage}" Height="5" Fill="{Binding ProgressColor}" RadiusX="2.5" RadiusY="2.5" Margin="10,0,0,10" Grid.Column="0" />

                            <Image Grid.Column="1" Source="H:\Software\C#\UI\Student_Data\Student_Data\assets\trophy.png" Height="38" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Rank}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,0" Grid.Column="2" />
                    <TextBlock Text="Close X" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Margin="0,4,4,0" Grid.Column="3" MouseDown="Close_MouseDown"/>
                </Grid>

            </Grid>
            
        </Border>
    </Grid>
</Window>
