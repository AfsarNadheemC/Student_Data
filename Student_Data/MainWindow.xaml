<Window x:Class="Student_Data.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Student_Data"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="400" d:DataContext="{d:DesignInstance Type=local:ViewModel }" Topmost="True">
    <Grid Margin="5,0">

        <Grid.RowDefinitions>
            
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SchoolName}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0"/>
        <TextBlock Text="{Binding Class}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0"/>
        <TextBlock Text="{Binding TeacherName}"  FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1"/>

        <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="80" Height="5" Fill="LightGray" RadiusX="2.5" RadiusY="2.5" Margin="0,0"/>
        <Rectangle Grid.Row="0" VerticalAlignment="Bottom"  HorizontalAlignment="Left" Width="40" Height="5" Fill="DarkGoldenrod" RadiusX="2.5" RadiusY="2.5" Margin="0,0"/>



        <ItemsControl ItemsSource="{Binding Students}" Grid.Row="2">
            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Background="WhiteSmoke" Margin="5" CornerRadius="10" Height="40" >

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="0" Opacity="0.3" />
                        </Border.Effect>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="16" Margin="5" Grid.Column="1" VerticalAlignment="Top"/>
                            <Rectangle  />

                        </Grid>
                        
                        
                    </Border>
                    
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</Window>
