                                <RadioButton Content="Examinations" Style="{StaticResource NavRadio}" Margin="5,0"  VerticalAlignment="Center" Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding DataContext.IsExaminations, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                    </Grid>

                </Border>


            </Grid>

        </Grid>

    </Grid>

</Window>
