<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UserSecretsId>47530f56-8fc1-488c-982e-b41f3ac09480</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="assets\Back.jpg" />
    <None Remove="assets\chevron.png" />
    <None Remove="assets\icon.ico" />
    <None Remove="assets\trophy - Copy.png" />
    <None Remove="assets\trophy.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\Back.jpg" />
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

</Project>
